 c***************************************************************************
 c***************************************************************************
 
+c *********************************************************************
+c nmbackend patch: Fermi momentum at baryon density bar(i)/sx,
+c interpolated in the star's own profile (bar decreases outward).
+c Above the central density: kF scaled as (n/n_c)^(1/3).
+c *********************************************************************
+      subroutine get_kf_scaled(sx,kf,kfs)
+       implicit real*8 (a-h,k-z)
+       INCLUDE 'size.inc.f'
+       INCLUDE 'profile_star.inc.f'
+       INCLUDE 'profile_comp.inc.f'
+       dimension kf(0:isize),kfs(0:isize)
+       do i=0,imax
+        if (sx.eq.1.d0) then
+         kfs(i)=kf(i)
+        else
+         b=bar(i)/sx
+         if (b.ge.bar(0)) then
+          kfs(i)=kf(0)*(b/bar(0))**(1.d0/3.d0)
+         else if (b.le.bar(imax)) then
+          kfs(i)=kf(imax)
+         else
+          j=0
+ 100      if (bar(j+1).ge.b) then
+           j=j+1
+           goto 100
+          end if
+          w=(bar(j)-b)/(bar(j)-bar(j+1))
+          kfs(i)=(1.d0-w)*kf(j)+w*kf(j+1)
+         end if
+        end if
+       end do
+      return
+      end

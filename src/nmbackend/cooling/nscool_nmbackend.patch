 c***************************************************************************
 c***************************************************************************
 
+c *********************************************************************
+c nmbackend patch: Fermi momentum at baryon density bar(i)/sx, for the
+c core zones i=0..icore, interpolated in the core zones only.  Outside
+c the core range (above the centre, or below the crust-core boundary,
+c where the star's kF is that of nuclei or zero) kF is scaled as
+c n^(1/3) from the nearest core zone: uniform matter at fixed
+c composition.  Crust zones keep their own kF.
+c *********************************************************************
+      subroutine get_kf_scaled(sx,kf,kfs)
+       implicit real*8 (a-h,k-z)
+       INCLUDE 'size.inc.f'
+       INCLUDE 'profile_star.inc.f'
+       INCLUDE 'profile_comp.inc.f'
+       dimension kf(0:isize),kfs(0:isize)
+       do i=0,imax
+        kfs(i)=kf(i)
+       end do
+       if (sx.eq.1.d0) return
+       do i=0,icore
+        b=bar(i)/sx
+        if (b.ge.bar(0)) then
+         kfs(i)=kf(0)*(b/bar(0))**(1.d0/3.d0)
+        else if (b.le.bar(icore)) then
+         kfs(i)=kf(icore)*(b/bar(icore))**(1.d0/3.d0)
+        else
+         j=0
+ 100     if (bar(j+1).ge.b) then
+          j=j+1
+          goto 100
+         end if
+         w=(bar(j)-b)/(bar(j)-bar(j+1))
+         kfs(i)=(1.d0-w)*kf(j)+w*kf(j+1)
+        end if
+       end do
+      return
+      end
